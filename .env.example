# Copy to .env.local and fill in. Never commit the real values.

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=
MONGODB_DB=lumiroam

# Gemma on the GPU Droplet, via Ollama's OpenAI-compatible API behind Caddy (HTTPS + bearer key)
GEMMA_BASE_URL=          # e.g. https://<droplet-ip>.sslip.io/v1
GEMMA_MODEL=gemma4:e4b
GEMMA_API_KEY=           # the bearer key Caddy checks; also used for the sketch server

# SDXL-Turbo sketch server on the same Droplet (leave empty to draw sketches from geometry)
SKETCH_URL=              # e.g. https://<droplet-ip>.sslip.io

# ElevenLabs text-to-speech for walk mode
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Identify ourselves to OSM/Wikimedia APIs (they throttle anonymous user agents)
LUMIROAM_USER_AGENT=
