# Copy to .env.local and fill in. Never commit the real values.

# MongoDB Atlas (free M0): shoots, spots, walk state, GridFS media, walk_points time series
MONGODB_URI=
MONGODB_DB=lumiroam

# Gemma over any OpenAI-compatible endpoint.
# Default: Hugging Face Inference Providers (needs HF credits)
HF_TOKEN=
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=google/gemma-4-31B-it
LLM_FALLBACK_MODEL=google/gemma-4-26B-A4B-it
# Free option A: Cloudflare Workers AI (one free account covers Gemma AND the drawings)
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<CLOUDFLARE_ACCOUNT_ID>/ai/v1
# LLM_API_KEY=<CLOUDFLARE_API_TOKEN>
# LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# LLM_FALLBACK_MODEL=@cf/google/gemma-3-12b-it
# Free option B: OpenRouter's free Gemma 4 tier (no card; rate-limited)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# Drawings: Gemma writes 4 prompts per spot from the real photo; FLUX.1 [schnell] draws them.
# T2I_PROVIDER=cloudflare (Workers AI, ~10k free neurons/day) or hf-space (ZeroGPU, a few/day)
T2I_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ElevenLabs text-to-speech for walk mode (without it, the phone's own voice reads the text)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4

# Identify ourselves to OSM/Wikimedia APIs (they throttle anonymous user agents)
LUMIROAM_USER_AGENT=
